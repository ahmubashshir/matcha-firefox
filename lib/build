#!/bin/sh
DIR="$(dirname "$(realpath "$0")")"
(
	cd "$1"
	set -e
	mkdir -p dist

	sassc -I "$DIR" theme.scss |
		"$DIR/jq/manifest" > dist/manifest.json

	"$DIR/jq/preview" < "dist/manifest.json" |
		sed -ne 'w dist/preview.svg'

	"$DIR/jq/icon" < "dist/manifest.json" |
		sed -ne 'w dist/icon.svg'
) && npx web-ext build -s "$1/dist"
